  {
    "id": "object-tracking",
    "term": "Object Tracking",
    "zh": "目标跟踪",
    "aliases": [
      "Tracking",
      "MOT"
    ],
    "category": "vision",
    "group": "视觉任务",
    "kind": "term",
    "summary": "目标跟踪在连续视频帧中定位物体，并维持同一物体的身份关联。",
    "detail": [
      "行人从画面左边走到右边，跟踪系统持续给他保留同一个编号。常见做法结合逐帧检测、运动预测与外观特征，处理短暂遮挡和重新出现。"
    ],
    "related": [
      "object-detection",
      "optical-flow",
      "bounding-box"
    ],
    "sources": [
      {
