  {
    "id": "vision-backbone",
    "term": "Backbone",
    "zh": "视觉骨干网络",
    "aliases": [
      "骨干网络"
    ],
    "category": "vision",
    "group": "视觉结构",
    "kind": "term",
    "summary": "视觉骨干网络把原始图像转换为后续任务可使用的特征表示。",
    "detail": [
      "一套检测器可以先用 ResNet 或 ViT 提取边缘、纹理与物体结构等信息，再由任务模块输出边界框和类别。骨干网络承担共用的视觉特征提取工作。"
    ],
    "related": [
      "vision-neck",
      "vision-head",
      "cnn",
      "vit"
    ],
    "sources": [
