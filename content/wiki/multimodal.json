  {
    "id": "contrastive-learning",
    "term": "Contrastive Learning",
    "zh": "对比学习",
    "aliases": [
      "对比式学习"
    ],
    "category": "multimodal",
    "group": "表示与检索",
    "kind": "term",
    "summary": "对比学习通过比较匹配与不匹配的样本，学习能体现语义关系的表示。",
    "detail": [
      "图文训练中，一张猫的照片应比同批次的汽车描述更接近对应的猫描述。把正例拉近、把对照样本区分开，可得到适合检索的向量空间。"
    ],
