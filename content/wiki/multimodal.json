[
  {
    "id": "modality",
    "term": "Modality",
    "zh": "模态",
    "aliases": [
      "信息模态"
    ],
    "category": "multimodal",
    "group": "多模态基础",
    "kind": "term",
    "summary": "模态是信息被表达或感知的形式，例如文字、图像、声音和触觉。",
    "detail": [
      "同一次敲门可以留下声音录音、视频画面和振动读数。不同模态包含互补线索，模型需要把它们转换为可计算的表示再联合使用。"
    ],
    "related": [
      "vlm",
      "multimodal-fusion",
      "asr"
    ],
    "sources": [
      {
        "title": "Visual Instruction Tuning",
        "url": "https://arxiv.org/abs/2304.08485"
      }
    ],
    "categories": [
      "multimodal"
    ]
  },
  {
    "id": "vlm",
    "term": "VLM",
    "zh": "视觉语言模型",
    "aliases": [
      "Vision-Language Model"
    ],
    "category": "multimodal",
    "group": "多模态基础",
    "kind": "term",
    "summary": "视觉语言模型联合处理图像与语言，学习两者之间的语义关系。",
    "detail": [
      "有的模型给图片和文字分别编码，用于相似度检索；有的模型根据图片生成说明或回答问题。VLM 描述视觉与语言的结合，具体输入输出随模型设计变化。"
    ],
    "related": [
      "mllm",
      "vision-encoder",
      "contrastive-learning"
    ],
    "sources": [
      {
        "title": "Learning Transferable Visual Models From Natural Language Supervision",
        "url": "https://arxiv.org/abs/2103.00020"
      }
    ],
    "categories": [
      "multimodal"
    ]
  },
  {
    "id": "mllm",
    "term": "MLLM",
    "zh": "多模态大语言模型",
    "aliases": [
      "Multimodal Large Language Model"
    ],
    "category": "multimodal",
    "group": "多模态基础",
    "kind": "term",
    "summary": "多模态大语言模型把图像、音频等信息接入大语言模型，使其能够结合多种输入理解或生成内容。",
    "detail": [
      "上传一张表格截图并询问哪项增长最多，模型需要先读取视觉信息，再结合问题生成回答。常见视觉方案由视觉编码器、连接模块和语言模型组成。"
    ],
    "related": [
      "vlm",
      "vision-encoder",
      "multimodal-projector",
      "vqa"
    ],
    "sources": [
