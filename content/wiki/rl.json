  {
    "id": "return",
    "term": "Return",
    "zh": "回报",
    "aliases": [
      "累计奖励"
    ],
    "category": "rl",
    "group": "决策基础",
    "kind": "term",
    "summary": "回报是从某一时刻起，将后续奖励按约定方式累加得到的总收益。",
    "detail": [
      "走迷宫时，眼前多走一步可能扣分，却能帮助最终抵达出口。回报把这些前后相连的结果放到一起计算，使策略能够权衡眼前收益和后续结果。"
    ],
    "related": [
      "reward",
      "discount-factor",
      "value-function"
    ],
    "sources": [
      {
        "title": "Spinning Up：强化学习基础",
