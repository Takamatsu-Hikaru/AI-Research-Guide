  {
    "id": "q-function",
    "term": "Q-function",
    "zh": "动作价值函数",
    "aliases": [
      "Q值",
      "Action Value"
    ],
    "category": "rl",
    "group": "价值与学习",
    "kind": "term",
    "summary": "动作价值函数估计在某状态先采取某个动作，再按指定策略继续行动的预期回报。",
    "detail": [
      "在一个路口，Q(路口,向左) 和 Q(路口,向右) 可以分别评分。比较动作的 Q 值，便能判断从当前位置先走哪一步更有前景。"
    ],
    "related": [
      "value-function",
      "dqn",
      "bellman-equation"
    ],
    "sources": [
      {
        "title": "Spinning Up：强化学习基础",
        "url": "https://spinningup.openai.com/en/latest/spinningup/rl_intro.html"
      }
    ],
