  {
    "id": "sparse-reward",
    "term": "Sparse Reward",
    "zh": "稀疏奖励",
    "aliases": [
      "稀疏反馈"
    ],
    "category": "rl",
    "group": "训练机制",
    "kind": "term",
    "summary": "稀疏奖励指有用的奖励反馈只在少数状态或事件出现。",
    "detail": [
      "机器人只有把钥匙插入锁孔才得到奖励，其他步骤都为零。训练必须从很少的成功信号中推断哪些尝试有帮助，因此探索和信用分配会变得更困难。"
    ],
