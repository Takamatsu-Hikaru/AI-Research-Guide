  {
    "id": "discount-factor",
    "term": "Discount Factor",
    "zh": "折扣因子",
    "aliases": [
      "Gamma",
      "γ"
    ],
    "category": "rl",
    "group": "决策基础",
    "kind": "term",
    "summary": "折扣因子决定计算回报时，较远未来的奖励占多大权重。",
    "detail": [
      "常用符号 γ 表示折扣因子：一步后的奖励乘 γ，两步后的奖励乘 γ²。γ 接近 1 时远期奖励保留得更多；γ 较小时，目标更偏向近期收益。"
    ],
    "related": [
      "return",
      "bellman-equation",
      "value-function"
    ],
